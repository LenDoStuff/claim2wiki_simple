# Copy the project endpoint from Azure AI Foundry, including /api/projects/...
# Example: https://YOUR-RESOURCE.services.ai.azure.com/api/projects/YOUR-PROJECT
FOUNDRY_PROJECT_ENDPOINT=
# The name of your GPT-5.6 Luna deployment in that project.
FOUNDRY_MODEL=gpt-5.6-luna
# Only needed for the optional `ocr` command: the name of a project connection
# whose target is your Document Intelligence resource endpoint. AIProjectClient
# resolves that connection using FOUNDRY_PROJECT_ENDPOINT; OCR also uses az login.
FOUNDRY_DOCUMENT_INTELLIGENCE_CONNECTION=
# Your identity needs access to both the project connection and the OCR resource.
# The OCR resource needs a paid tier for more than two pages.
# Authentication uses your local Azure CLI session: az login
